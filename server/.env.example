# DevPrep Server Configuration

# Runtime Port (default 5000)
PORT=5000

# Environment Mode ('development' | 'production')
NODE_ENV=development

# JWT Secret Key (required: min 32 characters in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Initial Admin Credentials (seed script)
ADMIN_EMAIL=admin********.com
ADMIN_PASSWORD=**********

# Client URL for CORS policy in production (e.g. https://devprep.vercel.app)
CLIENT_URL=http://localhost:5173

# Storage Driver Selection ('file' | 'postgres')
# Defaults to 'file' for local development. Set to 'postgres' when using Neon PostgreSQL.
STORAGE_DRIVER=file

# PostgreSQL Connection String (required when STORAGE_DRIVER=postgres)
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Demo User Provisioning in Production (optional, defaults to false in production)
ALLOW_DEMO_USER=false
